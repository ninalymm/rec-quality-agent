# 复制成 .env 后填一个即可（.env 不会进 git）
# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Qwen（阿里云百炼 DashScope）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 默认用哪家：deepseek | qwen | ollama
LLM_PROVIDER=deepseek
# 可选：调这些覆盖 app/config.py 里的默认值
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1500
